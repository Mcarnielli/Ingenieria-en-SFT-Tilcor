classDiagram
  direction LR
  class Usuario {
    +username string
    +password_hash string
    +nombre_completo string
    +rol string
    +activo bool
    +ultimo_acceso datetime
  }
  class Sensor {
    +codigo string
    +tipo tipo_sensor
    +ubicacion string
    +umbral_min decimal
    +umbral_max decimal
    +activo bool
  }
  class MotorAlertas {
    +evaluar(registro)
    -_umbrales(sensor)
    -_nivel(valor, umbrales)
  }
  Usuario ..> Sensor : configura umbral_min y umbral_max
  MotorAlertas ..> Sensor : lee umbrales vigentes