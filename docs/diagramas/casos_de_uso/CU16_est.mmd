classDiagram
  direction LR
  class TareasProgramadas {
    <<Celery>>
    +reporte_diario()
    +informe_semanal()
  }
  class Lote {
    +nro_lote string
    +fecha_inicio date
    +aves_iniciales int
    +activo bool
    +existencia_actual() int
    +semana_edad_actual() int
    +viabilidad_acumulada() decimal
  }
  class RegistroProduccion {
    +fecha date
    +semana_edad int
    +huevos_totales int
    +cajones int
    +maples int
    +aves_muertas int
    +existencia int
    +porc_postura() decimal
    +desvio_vs_tabla() decimal
    +tiene_alerta_produccion() bool
  }
  class GeneradorPDF {
    +generar(indicadores)
  }
  class ServicioEmail {
    +enviar(destino, adjunto)
  }
  Lote "1" --> "*" RegistroProduccion
  TareasProgramadas ..> RegistroProduccion : consolida la semana
  TareasProgramadas ..> GeneradorPDF : informe
  TareasProgramadas ..> ServicioEmail : envia al veterinario