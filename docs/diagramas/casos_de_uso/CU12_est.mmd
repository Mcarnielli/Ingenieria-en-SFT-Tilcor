%%{init: {'theme':'base','themeVariables':{'primaryColor':'#EAF2F8','primaryBorderColor':'#1A5276','primaryTextColor':'#1C1C1C','lineColor':'#1A5276','secondaryColor':'#FEF9E7','tertiaryColor':'#F2F3F4','fontFamily':'Arial','fontSize':'15px','noteBkgColor':'#FEF9E7','actorBkg':'#EAF2F8','actorBorder':'#1A5276','signalColor':'#1A5276'}}}%%
classDiagram
  direction LR
  class DashboardPrincipal {
    +kpis()
    +alertas_activas()
    +resumen_comercial()
  }
  class RegistroProduccion {
    +fecha date
    +semana_edad int
    +huevos_totales int
    +cajones int
    +maples int
    +aves_muertas int
    +existencia int
    +porc_postura() decimal
    +desvio_vs_tabla() decimal
    +tiene_alerta_produccion() bool
  }
  class Lote {
    +nro_lote string
    +fecha_inicio date
    +aves_iniciales int
    +activo bool
    +existencia_actual() int
    +semana_edad_actual() int
    +viabilidad_acumulada() decimal
  }
  class RegistroSensor {
    +timestamp datetime
    +valor decimal
    +unidad string
  }
  class PlanImplementacion {
    +fases list
    +guardar(progreso)
    +descartar()
  }
  class DonGestion {
    <<sistema externo>>
  }
  DashboardPrincipal ..> RegistroProduccion : produccion y postura
  DashboardPrincipal ..> Lote : viabilidad
  DashboardPrincipal ..> RegistroSensor : alertas IoT
  DashboardPrincipal ..> PlanImplementacion : plan
  DashboardPrincipal ..> DonGestion : resumen comercial