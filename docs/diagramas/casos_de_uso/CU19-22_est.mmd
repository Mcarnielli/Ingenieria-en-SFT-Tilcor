classDiagram
  direction LR
  class Sensor {
    +codigo string
    +tipo tipo_sensor
    +ubicacion string
    +umbral_min decimal
    +umbral_max decimal
    +activo bool
  }
  class BrokerMosquitto {
    <<externo>>
  }
  class GatewayMQTT {
    +conectar(host, port)
    -_on_message(msg)
  }
  class RegistroSensor {
    +timestamp datetime
    +valor decimal
    +unidad string
  }
  class MotorAlertas {
    +evaluar(registro)
    -_umbrales(sensor)
    -_nivel(valor, umbrales)
  }
  class AlertaIoT {
    +timestamp datetime
    +nivel string
    +valor decimal
    +mensaje string
    +revisada bool
  }
  class Notificador {
    +enviar_push()
    +enviar_whatsapp()
    +enviar_email()
  }
  class ConsumidorWebSocket {
    +connect()
    +enviar_lectura()
  }
  Sensor ..> BrokerMosquitto : publica JSON QoS 1
  BrokerMosquitto ..> GatewayMQTT : entrega mensaje
  GatewayMQTT ..> RegistroSensor : persiste
  GatewayMQTT ..> MotorAlertas : evalua
  MotorAlertas ..> AlertaIoT : registra
  AlertaIoT ..> Notificador : notifica
  GatewayMQTT ..> ConsumidorWebSocket : transmite al dashboard