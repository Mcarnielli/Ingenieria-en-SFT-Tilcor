classDiagram
  direction LR
  class MotorAlertas {
    +evaluar(registro)
    -_umbrales(sensor)
    -_nivel(valor, umbrales)
  }
  class RegistroSensor {
    +timestamp datetime
    +valor decimal
    +unidad string
  }
  class AlertaIoT {
    +timestamp datetime
    +nivel string
    +valor decimal
    +mensaje string
    +revisada bool
  }
  class Notificador {
    +enviar_push()
    +enviar_whatsapp()
    +enviar_email()
  }
  MotorAlertas ..> RegistroSensor : evalua
  MotorAlertas ..> AlertaIoT : registra Critico
  AlertaIoT ..> Notificador : push y WhatsApp