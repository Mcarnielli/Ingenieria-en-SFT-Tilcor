classDiagram
  direction LR
  class Lote {
    +nro_lote string
    +fecha_inicio date
    +aves_iniciales int
    +activo bool
    +existencia_actual() int
    +semana_edad_actual() int
    +viabilidad_acumulada() decimal
  }
  class RegistroProduccion {
    +fecha date
    +semana_edad int
    +huevos_totales int
    +cajones int
    +maples int
    +aves_muertas int
    +existencia int
    +porc_postura() decimal
    +desvio_vs_tabla() decimal
    +tiene_alerta_produccion() bool
  }
  class AlertaProductiva {
    +nivel string
    +mensaje string
    +fecha date
  }
  class TablaGenetica {
    +semana_edad int
    +prod_tabla decimal
    +viab_tabla decimal
  }
  Lote "1" --> "*" RegistroProduccion
  RegistroProduccion ..> AlertaProductiva : umbral de mortalidad
  Lote ..> TablaGenetica : viabilidad de referencia