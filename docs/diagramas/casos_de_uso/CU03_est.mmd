classDiagram
  direction LR
  class Sensor {
    +codigo string
    +tipo tipo_sensor
    +ubicacion string
    +umbral_min decimal
    +umbral_max decimal
    +activo bool
  }
  class RegistroSensor {
    +timestamp datetime
    +valor decimal
    +unidad string
  }
  class Galpon {
    +numero int
    +capacidad_max int
  }
  class ConsumidorWebSocket {
    +connect()
    +enviar_lectura()
  }
  Galpon "1" --> "*" Sensor
  Sensor "1" --> "*" RegistroSensor
  ConsumidorWebSocket ..> RegistroSensor : ultimo valor por sensor